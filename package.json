{
  "name": "pwd-fs",
  "version": "3.5.7",
  "description": "Path-aware file system utilities with scoped working directories and recursive operations",
  "keywords": [
    "umask",
    "test",
    "stat",
    "chmod",
    "chown",
    "symlink",
    "copy",
    "rename",
    "remove",
    "read",
    "write",
    "readdir",
    "mkdir"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/pwd-fs.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/woodger/pwd-fs/issues"
  },
  "homepage": "https://github.com/woodger/pwd-fs#readme",
  "engines": {
    "node": ">=14.18.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "fwa --prune",
    "lint": "biome lint src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "20.19.25",
    "fwa": "^2.1.0",
    "typescript": "7.0.2"
  }
}
